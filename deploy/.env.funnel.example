# Copy to deploy/.env.funnel. This staging-only file is ignored by Git.
# Use fresh local secrets; never reuse VPS or production credentials.
# Replace the hostname placeholders with the MagicDNS name shown by
# `tailscale status` or `tailscale funnel status` (no trailing slash).

# Required by the shared production Compose environment. Caddyfile.funnel does
# not use these hostnames because Funnel owns public HTTPS and host routing.
APP_DOMAIN=replace-with-your-machine.tailnet.ts.net
API_DOMAIN=replace-with-your-machine.tailnet.ts.net
ACME_EMAIL=staging-operator@example.invalid

APP_ENV=production
LOG_LEVEL=INFO
IMAGE_TAG=funnel-staging-local

# Compiled into the web image. It must remain the one public Funnel origin.
NEXT_PUBLIC_API_BASE_URL=https://replace-with-your-machine.tailnet.ts.net/api
# Exact same origin is passed to FastAPI CORS; no trailing slash.
FRONTEND_ORIGIN=https://replace-with-your-machine.tailnet.ts.net

# Generate all values below independently. Do not run with the placeholders.
VIDEO_CURSOR_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_CURSOR_SECRET_AT_LEAST_32_CHARACTERS

POSTGRES_DB=offline_reels
POSTGRES_USER=offline_reels
POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://offline_reels:REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD@postgres:5432/offline_reels

REDIS_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD@redis:6379/0

MINIO_ROOT_USER=REPLACE_WITH_A_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_A_MINIO_APPLICATION_USER
MINIO_SECRET_KEY=REPLACE_WITH_A_RANDOM_MINIO_APPLICATION_SECRET
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=offline-reels
