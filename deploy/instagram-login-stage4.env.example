# Copy to deploy/.env.instagram-login-stage4 and replace every secret locally.
LOGIN_POSTGRES_PASSWORD=replace-with-a-disposable-stage4-postgres-password
LOGIN_GATEWAY_SESSION_SECRET=replace-with-at-least-32-random-characters
LOGIN_BROWSER_CONTROL_SECRET=replace-with-at-least-32-random-characters
# Required only because Alembic imports the normal settings model; Stage 4
# does not use the video cursor.
LOGIN_VIDEO_CURSOR_SECRET=replace-with-at-least-32-random-characters
# This must equal the Funnel sidecar DNS name, never http://.
LOGIN_GATEWAY_ORIGIN=https://offline-reels-stage4-login.replace-with-your-tailnet.ts.net
# Generate an ephemeral, preauthorized, non-reusable key.
# Do not commit or print it. Funnel permission belongs in tailnet policy.
TAILSCALE_AUTHKEY=replace-with-a-restricted-tailscale-auth-key
TAILSCALE_HOSTNAME=offline-reels-stage4-login
# Keep this stable for a repeat-login smoke; it owns the Stage 4 test profile.
LOGIN_ACCOUNT_ID=00000000-0000-0000-0000-000000000400
