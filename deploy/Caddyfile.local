# Local Docker Desktop smoke only. Explicit http:// addresses prevent Caddy
# from requesting public ACME certificates for *.localhost.
http://app.localhost {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy web:3000
}

http://api.localhost {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Preserve upstream streaming and HTTP Range headers unchanged.
    reverse_proxy api:8000
}
