# The optional Funnel host is supplied only by the disposable iPhone launcher.
# Local Chromium E2E continues to use the localhost site without any Funnel.
https://localhost, https://{$STAGE9_CADDY_FUNNEL_HOST:stage9-funnel.invalid} {
    tls internal
    @service_worker path /serwist/sw.js
    header @service_worker Cache-Control "no-store, max-age=0, must-revalidate"
    handle /api/videos* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000 {
            header_down Cache-Control "no-store"
        }
    }
    handle /health/* {
        reverse_proxy api:8000
    }
    handle /connect/* {
        reverse_proxy login-gateway:8080
    }
    handle {
        reverse_proxy web:3000
    }
}
