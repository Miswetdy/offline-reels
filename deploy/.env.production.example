# Copy this file to deploy/.env.production on the VPS and replace every
# REPLACE_WITH_* value before running Docker Compose. This template is safe to
# commit; deploy/.env.production is ignored by Git and must have mode 0600.

# Public DNS hostnames only: no scheme, path, port, credentials, or wildcard.
APP_DOMAIN=app.example.invalid
API_DOMAIN=api.example.invalid
ACME_EMAIL=ops@example.invalid

APP_ENV=production
LOG_LEVEL=INFO
IMAGE_TAG=replace-with-immutable-git-sha

# This public value is compiled into the Next.js image. Rebuild web after it changes.
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
# Exact browser origin accepted by FastAPI CORS. No trailing slash.
FRONTEND_ORIGIN=https://app.example.invalid

# Generate at least 32 random characters, for example with: openssl rand -base64 48
VIDEO_CURSOR_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_CURSOR_SECRET_AT_LEAST_32_CHARACTERS

POSTGRES_DB=offline_reels
POSTGRES_USER=offline_reels
# Generate a URL-safe secret. Do not leave this placeholder in a running deployment.
POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD
# Keep the password URL-safe or percent-encode it in this DSN.
DATABASE_URL=postgresql+psycopg://offline_reels:REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD@postgres:5432/offline_reels

# Generate a URL-safe secret and use the exact same value in REDIS_URL.
REDIS_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD@redis:6379/0

# Root credentials are used only by MinIO and the one-shot bootstrap service.
MINIO_ROOT_USER=REPLACE_WITH_A_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_MINIO_ROOT_PASSWORD
# API credentials are a different, least-privileged MinIO user.
MINIO_ACCESS_KEY=REPLACE_WITH_A_MINIO_APPLICATION_USER
MINIO_SECRET_KEY=REPLACE_WITH_A_RANDOM_MINIO_APPLICATION_SECRET
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=offline-reels
