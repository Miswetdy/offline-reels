# Stage 10 Linux staging template. Copy to deploy/.env.stage10, chmod 0600,
# and replace every REPLACE_WITH_* value on the staging host.
APP_DOMAIN=app.example.invalid
API_DOMAIN=api.example.invalid
ACME_EMAIL=ops@example.invalid

APP_ENV=staging
LOG_LEVEL=INFO
IMAGE_TAG=replace-with-immutable-git-sha
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_TAILSCALE_HOSTNAME
FRONTEND_ORIGIN=https://REPLACE_WITH_TAILSCALE_HOSTNAME
MANAGEMENT_ORIGIN=https://REPLACE_WITH_TAILSCALE_HOSTNAME
VIDEO_CURSOR_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_CURSOR_SECRET_AT_LEAST_32_CHARACTERS
LOGIN_GATEWAY_SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_LOGIN_GATEWAY_SECRET_AT_LEAST_32_CHARACTERS
LOGIN_BROWSER_CONTROL_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_LOGIN_BROWSER_SECRET_AT_LEAST_32_CHARACTERS

POSTGRES_DB=offline_reels_stage10
POSTGRES_USER=offline_reels_stage10
POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://offline_reels_stage10:REPLACE_WITH_A_URL_SAFE_RANDOM_POSTGRES_PASSWORD@postgres:5432/offline_reels_stage10
REDIS_PASSWORD=REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_URL_SAFE_RANDOM_REDIS_PASSWORD@redis:6379/0

MINIO_ROOT_USER=REPLACE_WITH_A_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_A_MINIO_APPLICATION_USER
MINIO_SECRET_KEY=REPLACE_WITH_A_RANDOM_MINIO_APPLICATION_SECRET
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=offline-reels-stage10

# Not a secret. Generate a staging-only UUID; never reuse a production account.
COLLECTOR_ACCOUNT_ID=REPLACE_WITH_A_STAGE10_ACCOUNT_UUID
