# Application
APP_ENV=development
LOG_LEVEL=INFO

# Public host ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Browser-facing API URL. This public value is compiled into the web application image.
# Local Docker development uses localhost. For iPhone acceptance, use the HTTPS
# URL of the API tunnel; never use a phone-local localhost address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Explicit browser origin accepted by the API CORS policy. For iPhone acceptance,
# set this to the HTTPS frontend tunnel origin (without a trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# Required to sign opaque video pagination cursors. Replace with a unique random value in production.
# The template is intentionally non-production and satisfies the 32-character minimum only for local startup.
VIDEO_CURSOR_SECRET=change-me-use-a-unique-local-cursor-secret-32-chars

# PostgreSQL
POSTGRES_DB=offline_reels
POSTGRES_USER=offline_reels
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://offline_reels:change-me-local-postgres-password@postgres:5432/offline_reels

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO. Replace the example credentials before exposing any environment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=offline-reels
# Root credentials configure the MinIO server. API credentials authenticate the application.
# They may match locally, but production should use a separate least-privileged application user.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-local-minio-password

# Isolated TASK-003 integration infrastructure. These values never target dev volumes or bucket.
TEST_POSTGRES_DB=offline_reels_test
TEST_POSTGRES_USER=offline_reels_test
TEST_POSTGRES_PASSWORD=change-me-test-postgres-password
TEST_MINIO_ROOT_USER=minio-test-admin
TEST_MINIO_ROOT_PASSWORD=change-me-test-minio-password
TEST_MINIO_BUCKET=offline-reels-test
TEST_VIDEO_CURSOR_SECRET=test-only-video-cursor-secret-with-at-least-32-characters
