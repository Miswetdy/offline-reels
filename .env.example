# Application
APP_ENV=development
LOG_LEVEL=INFO

# Public host ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Browser-facing API URL. This value is compiled into the web application image.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Explicit browser origin accepted by the API CORS policy.
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=offline_reels
POSTGRES_USER=offline_reels
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://offline_reels:change-me-local-postgres-password@postgres:5432/offline_reels

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO. Replace the example credentials before exposing any environment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=offline-reels
# Root credentials configure the MinIO server. API credentials authenticate the application.
# They may match locally, but production should use a separate least-privileged application user.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-local-minio-password

# Isolated TASK-003 integration infrastructure. These values never target dev volumes or bucket.
TEST_POSTGRES_DB=offline_reels_test
TEST_POSTGRES_USER=offline_reels_test
TEST_POSTGRES_PASSWORD=change-me-test-postgres-password
TEST_MINIO_ROOT_USER=minio-test-admin
TEST_MINIO_ROOT_PASSWORD=change-me-test-minio-password
TEST_MINIO_BUCKET=offline-reels-test
